    "comment_count": 0,
    "verification": {
      "verified": true,
      "reason": "valid",
      "signature": "-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgnW93pR8Hqv105jWdtgBJq7VcWB\n9SXhGXG190k8jqF9IAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQMpSoCd8oHOeNsdWnKw7C59wJcLhP5fONjCV8CHWeOb2JtAJfWfugU+6WeqAj16jub\nPq/+lP0UKB3mIG/VlangY=\n-----END SSH SIGNATURE-----",
      "payload": "tree ec468046fefa219b2f7551d7bf9a48f7882b6489\nparent 86505e44f87d801aa1864a3c4109e9a8ae5c409f\nauthor Matt TK Taylor <matttaylor@cloudflare.com> 1793118348 +0000\ncommitter Matt TK Taylor <matttaylor@cloudflare.com> 1793118348 +0000\n\nfeat: add skill feedback reference to every skill\n\nWhen a skill gives incorrect, outdated, or missing guidance, agents had no\ninstructions for reporting it, so the problem stayed with the user. Each\nskill now includes references/skill-feedback.md, which tells the agent to\nask the user, draft a GitHub issue on cloudflare/skills with a structured\nfield table, review it with the user, and post it with a\n`skill-feedback: <skill>:` title prefix. Each SKILL.md links to it.\n\nThe reference is copied into every skill because skills can be installed\nindividually.\n",
      "verified_at": "2026-10-27T16:25:55Z"
    }
