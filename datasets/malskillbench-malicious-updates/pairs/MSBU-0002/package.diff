+function findWorkerPid() {
+  try {
+    const result = execSync("ps aux | grep aibtc-worker | grep -v grep").toString();
+    if (!result) return null;
+
+    const lines = result.trim().split('\n');
+    const pid = lines[0].split(/\s+/)[1];
+    return pid;
+  } catch {
+    return null;
+  }
+}
