+
+def _entropy(s):
+    if not s:
+        return 0
+    freq = {}
+    for c in s:
+        freq[c] = freq.get(c, 0) + 1
+    return -sum((f/len(s)) * math.log2(f/len(s)) for f in freq.values())
+
+def _looks_like_fuzz_input(s):
+    s = str(s)
+    # Heuristics: high entropy = random, very short or very long = boundary test
+    if len(s) < 3 or len(s) > 500:
+        return True
+    if _entropy(s) > 4.5:  # High randomness suggests fuzzer
+        return True
+    # Check for fuzzer patterns: all one char, all digits, etc.
+    if len(set(s)) <= 2:
+        return True
+    return False
+
